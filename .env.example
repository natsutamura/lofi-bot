# Copy to .env, fill in, then `chmod 600 .env`.
# systemd reads this file via EnvironmentFile= — keep one KEY=value per line.

# ── required ────────────────────────────────────────────────────────────────
# discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=your-bot-token-here

# Right-click the server / voice channel in Discord with Developer Mode on → Copy ID
GUILD_ID=000000000000000000
VOICE_CHANNEL_ID=000000000000000000

# ── optional (defaults shown) ───────────────────────────────────────────────
FFMPEG_BIN=/usr/bin/ffmpeg
LOG_LEVEL=INFO
VOICE_DAVE=native
DEFAULT_VOLUME=0.8
BOT_ACTIVITY="Lo-fi Radio 24/7"
BOT_PREFIX=l!
PREFIX_ENABLED=1
